rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : "";
    }

    function isMasterEmail() {
      return signedIn() &&
        request.auth.token.email == "rosabaya08@gmail.com";
    }

    function isSuperAdmin() {
      return isMasterEmail();
    }

    function isCompanyAdmin(companyId) {
      return signedIn() &&
        role() == "COMPANY_ADMIN" &&
        request.auth.token.company_id == companyId;
    }

    function isNurseryAdmin(nurseryId) {
      return signedIn() &&
        role() == "NURSERY_ADMIN" &&
        request.auth.token.nursery_id == nurseryId;
    }

    function safeImageOrVideo(maxMb) {
      return request.resource != null &&
        request.resource.size < maxMb * 1024 * 1024 &&
        (
          request.resource.contentType.matches("image/.*") ||
          request.resource.contentType.matches("video/.*")
        );
    }

    function safeDocument(maxMb) {
      return request.resource != null &&
        request.resource.size < maxMb * 1024 * 1024 &&
        (
          request.resource.contentType == "application/pdf" ||
          request.resource.contentType.matches("image/.*")
        );
    }

    match /public/storefront/{fileName=**} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /companies/{companyId}/products/{productId}/images/{fileName=**} {
      allow read: if true;
      allow create, update: if (isSuperAdmin() || isCompanyAdmin(companyId)) && safeImageOrVideo(25);
      allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
    }

    match /companies/{companyId}/products/{productId}/detail/{fileName=**} {
      allow read: if true;
      allow create, update: if (isSuperAdmin() || isCompanyAdmin(companyId)) && safeImageOrVideo(25);
      allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
    }

    match /companies/{companyId}/products/{productId}/gifs/{fileName=**} {
      allow read: if true;
      allow create, update: if (isSuperAdmin() || isCompanyAdmin(companyId)) && safeImageOrVideo(25);
      allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
    }

    match /companies/{companyId}/products/{productId}/videos/{fileName=**} {
      allow read: if true;
      allow create, update: if (isSuperAdmin() || isCompanyAdmin(companyId)) && safeImageOrVideo(100);
      allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
    }

    match /companies/{companyId}/ad-materials/{fileName=**} {
      allow read: if true;
      allow create, update: if (isSuperAdmin() || isCompanyAdmin(companyId)) && safeImageOrVideo(100);
      allow delete: if isSuperAdmin() || isCompanyAdmin(companyId);
    }

    match /companies/{companyId}/onboarding/{fileName=**} {
      allow read: if isSuperAdmin() || isCompanyAdmin(companyId);
      allow create, update: if isCompanyAdmin(companyId) && safeDocument(20);
      allow delete: if isSuperAdmin();
    }

    match /companies/{companyId}/bank-documents/{fileName=**} {
      allow read: if isSuperAdmin() || isCompanyAdmin(companyId);
      allow create, update: if isCompanyAdmin(companyId) && safeDocument(20);
      allow delete: if isSuperAdmin();
    }

    match /nurseries/{nurseryId}/business-documents/{fileName=**} {
      allow read: if isSuperAdmin() || isNurseryAdmin(nurseryId);
      allow create, update, delete: if false;
    }

    match /nurseries/{nurseryId}/rooms/{roomId}/tablet-proofs/{fileName=**} {
      allow read: if isSuperAdmin() || isNurseryAdmin(nurseryId);
      allow create, update, delete: if false;
    }

    match /settlements/{period}/{companyId}/{fileName=**} {
      allow read: if isSuperAdmin() || isCompanyAdmin(companyId);
      allow write: if false;
    }

    match /payouts/{period}/{companyId}/{fileName=**} {
      allow read: if isSuperAdmin() || isCompanyAdmin(companyId);
      allow write: if false;
    }

    match /policies/{policyId}/{fileName=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /audit-exports/{yyyy}/{mm}/{fileName=**} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
