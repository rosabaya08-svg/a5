rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function token() {
      return request.auth.token;
    }

    function role() {
      return signedIn() && ("role" in token()) ? token().role : "";
    }

    function hasRole(targetRole) {
      return signedIn() &&
        accessActive() &&
        (
          role() == targetRole ||
          (("roles" in token()) && token().roles is list && targetRole in token().roles)
        );
    }

    function accessActive() {
      return signedIn() &&
        (!("access_status" in token()) || token().access_status == "ACTIVE");
    }

    function uid() {
      return signedIn() ? request.auth.uid : "";
    }

    function organizationId() {
      return signedIn() && ("organization_id" in token())
        ? token().organization_id
        : signedIn() && ("company_id" in token())
          ? token().company_id
          : "";
    }

    function nurseryId() {
      return signedIn() && ("nursery_id" in token()) ? token().nursery_id : "";
    }

    function roomId() {
      return signedIn() && ("room_id" in token()) ? token().room_id : "";
    }

    function tabletId() {
      return signedIn() && ("tablet_id" in token()) ? token().tablet_id : "";
    }

    function isSuperAdmin() {
      return hasRole("SUPER_ADMIN");
    }

    function isSeedAdmin() {
      return signedIn() && accessActive() &&
        (
          (("seed_admin" in token()) && token().seed_admin == true) ||
          role() == "seed_admin"
        );
    }

    function isAdminReader() {
      return isSuperAdmin() ||
        hasRole("FINANCE_ADMIN") ||
        hasRole("OPERATIONS_ADMIN") ||
        hasRole("SUPPORT_ADMIN") ||
        hasRole("AUDITOR") ||
        isSeedAdmin();
    }

    function isAdminWriter() {
      return isSuperAdmin() || hasRole("OPERATIONS_ADMIN") || isSeedAdmin();
    }

    function isCompanyRole() {
      return hasRole("COMPANY_ADMIN") || hasRole("SUPPLIER_ADMIN") || hasRole("PARTNER_ADMIN") || hasRole("A5LS_ADMIN");
    }

    function userActive() {
      return signedIn() && accessActive() &&
        (
          !exists(/databases/$(database)/documents/users/$(uid())) ||
          get(/databases/$(database)/documents/users/$(uid())).data.account_status in ["active", "approved"]
        );
    }

    function companyApproved(companyId) {
      return exists(/databases/$(database)/documents/companies/$(companyId)) &&
        get(/databases/$(database)/documents/companies/$(companyId)).data.status in ["approved", "active"];
    }

    function isCompanyAdmin(companyId) {
      return userActive() &&
        isCompanyRole() &&
        organizationId() == companyId &&
        companyApproved(companyId);
    }

    function isNurseryAdmin(targetNurseryId) {
      return userActive() && hasRole("NURSERY_ADMIN") && nurseryId() == targetNurseryId;
    }

    function isTabletDevice(targetNurseryId, targetRoomId, targetTabletId) {
      return userActive() &&
        hasRole("TABLET_DEVICE") &&
        nurseryId() == targetNurseryId &&
        roomId() == targetRoomId &&
        tabletId() == targetTabletId;
    }

    function hasStatus(data, allowed) {
      return ("status" in data) && data.status in allowed;
    }

    function companyScoped(data) {
      return (
        ("company_id" in data && isCompanyAdmin(data.company_id)) ||
        ("organization_id" in data && isCompanyAdmin(data.organization_id))
      );
    }

    function nurseryScoped(data) {
      return ("nursery_id" in data) && isNurseryAdmin(data.nursery_id);
    }

    function tabletScoped(data) {
      return ("nursery_id" in data) &&
        ("room_id" in data) &&
        ("tablet_id" in data) &&
        isTabletDevice(data.nursery_id, data.room_id, data.tablet_id);
    }

    function activeProduct(data) {
      return hasStatus(data, ["approved", "active"]) &&
        ("company_id" in data) &&
        companyApproved(data.company_id) &&
        (!("is_visible" in data) || data.is_visible == true);
    }

    function activeOption(data) {
      return hasStatus(data, ["active", "approved"]) &&
        (!("company_id" in data) || companyApproved(data.company_id));
    }

    function activeContent(data) {
      return hasStatus(data, ["approved", "active", "published", "live"]) &&
        (!("visible_from" in data) || data.visible_from <= request.time) &&
        (!("visible_until" in data) || data.visible_until >= request.time);
    }

    function companyCreatesPending(data) {
      return ("company_id" in data) &&
        isCompanyAdmin(data.company_id) &&
        data.status in ["draft", "pending_approval"] &&
        ("updated_at" in data);
    }

    function companyKeepsOwnership(beforeData, afterData) {
      return ("company_id" in beforeData) &&
        ("company_id" in afterData) &&
        beforeData.company_id == afterData.company_id &&
        isCompanyAdmin(afterData.company_id);
    }

    function companyUpdatesPending(beforeData, afterData) {
      return companyKeepsOwnership(beforeData, afterData) &&
        beforeData.status in ["draft", "pending_approval", "rejected", "needs_revision"] &&
        afterData.status in ["draft", "pending_approval"] &&
        ("updated_at" in afterData);
    }

    function adminStatusWrite(data) {
      return isAdminWriter() && ("status" in data) && ("updated_at" in data);
    }

    match /users/{userId} {
      allow get: if isAdminReader() || (signedIn() && uid() == userId);
      allow list: if isAdminReader();
      allow create, update, delete: if isAdminWriter();
    }

    match /company_signup_requests/{requestId} {
      allow get, list: if isAdminReader();
      allow create, update, delete: if false;
    }

    match /companies/{companyId} {
      allow get: if isAdminReader() || isCompanyAdmin(companyId);
      allow list: if isAdminReader();
      allow create, update: if adminStatusWrite(request.resource.data);
      allow delete: if false;
    }

    match /company_onboarding/{onboardingId} {
      allow get, list: if isAdminReader() || companyScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /company_documents/{documentId} {
      allow get, list: if isAdminReader() || companyScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /company_contacts/{contactId} {
      allow get, list: if activeContent(resource.data) || isAdminReader() || companyScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /products/{productId} {
      allow get, list: if activeProduct(resource.data) || companyScoped(resource.data) || isAdminReader();
      allow create: if companyCreatesPending(request.resource.data) || adminStatusWrite(request.resource.data);
      allow update: if companyUpdatesPending(resource.data, request.resource.data) || adminStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /product_options/{optionId} {
      allow get, list: if activeOption(resource.data) || companyScoped(resource.data) || isAdminReader();
      allow create: if companyCreatesPending(request.resource.data) || adminStatusWrite(request.resource.data);
      allow update: if companyUpdatesPending(resource.data, request.resource.data) || adminStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /product_detail_pages/{pageId} {
      allow get, list: if activeContent(resource.data) || companyScoped(resource.data) || isAdminReader();
      allow create: if companyCreatesPending(request.resource.data) || adminStatusWrite(request.resource.data);
      allow update: if companyUpdatesPending(resource.data, request.resource.data) || adminStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /product_reviews/{reviewId} {
      allow get, list: if activeContent(resource.data) || companyScoped(resource.data) || isAdminReader();
      allow create, update, delete: if false;
    }

    match /product_questions/{questionId} {
      allow get, list: if companyScoped(resource.data) || isAdminReader();
      allow create, update, delete: if false;
    }

    match /brands/{brandId} {
      allow get, list: if activeContent(resource.data) || companyScoped(resource.data) || isAdminReader();
      allow create, update: if isAdminWriter() && ("status" in request.resource.data) && ("updated_at" in request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /home_sections/{sectionId} {
      allow get, list: if activeContent(resource.data) || isAdminReader();
      allow create, update: if isAdminWriter() && ("status" in request.resource.data) && ("updated_at" in request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /marketing_banners/{bannerId} {
      allow get, list: if activeContent(resource.data) || companyScoped(resource.data) || isAdminReader();
      allow create, update: if isAdminWriter() && ("status" in request.resource.data) && ("updated_at" in request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /marketing_videos/{videoId} {
      allow get, list: if activeContent(resource.data) || companyScoped(resource.data) || isAdminReader();
      allow create, update: if isAdminWriter() && ("status" in request.resource.data) && ("updated_at" in request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /exhibitions/{exhibitionId} {
      allow get, list: if activeContent(resource.data) || companyScoped(resource.data) || isAdminReader();
      allow create, update: if adminStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /exhibition_products/{entryId} {
      allow get, list: if activeContent(resource.data) || companyScoped(resource.data) || isAdminReader();
      allow create, update: if adminStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /popups/{popupId} {
      allow get, list: if activeContent(resource.data) || isAdminReader();
      allow create, update: if adminStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /tablet_home_configs/{configId} {
      allow get, list: if activeContent(resource.data) || nurseryScoped(resource.data) || tabletScoped(resource.data) || isAdminReader();
      allow create, update: if isAdminWriter() && ("status" in request.resource.data) && ("updated_at" in request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /media_assets/{assetId} {
      allow get, list: if activeContent(resource.data) || companyScoped(resource.data) || nurseryScoped(resource.data) || isAdminReader();
      allow create: if companyCreatesPending(request.resource.data) || adminStatusWrite(request.resource.data);
      allow update: if companyUpdatesPending(resource.data, request.resource.data) || adminStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /nurseries/{targetNurseryId} {
      allow get: if isAdminReader() || isNurseryAdmin(targetNurseryId);
      allow list: if isAdminReader();
      allow create, update: if adminStatusWrite(request.resource.data);
      allow delete: if false;
    }

    match /rooms/{targetRoomId} {
      allow get, list: if isAdminReader() || nurseryScoped(resource.data) || tabletScoped(resource.data);
      allow create, update: if adminStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /tablets/{targetTabletId} {
      allow get, list: if isAdminReader() || nurseryScoped(resource.data) || tabletScoped(resource.data);
      allow create, update: if adminStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /carts/{cartId} {
      allow get, list: if isAdminReader() || nurseryScoped(resource.data) || tabletScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /cart_items/{cartItemId} {
      allow get, list: if isAdminReader() || nurseryScoped(resource.data) || tabletScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /qr_payment_sessions/{sessionId} {
      allow get, list: if isAdminReader() || nurseryScoped(resource.data) || tabletScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /orders/{orderId} {
      allow get, list: if isAdminReader() || nurseryScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /order_items/{orderItemId} {
      allow get, list: if isAdminReader() || companyScoped(resource.data) || nurseryScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /inventory_movements/{movementId} {
      allow get, list: if isAdminReader() || companyScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /delivery_events/{eventId} {
      allow get, list: if isAdminReader() || companyScoped(resource.data) || nurseryScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /pickup_events/{eventId} {
      allow get, list: if isAdminReader() || companyScoped(resource.data) || nurseryScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /system_status/{statusId} {
      allow get, list: if signedIn();
      allow create, update: if adminStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /policies/{policyId} {
      allow get, list: if activeContent(resource.data) || signedIn();
      allow create, update: if adminStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // PayUp 금융·자격증명·감사·승인 원장은 Firebase Admin SDK 전용입니다.
    // A5S/A5WS/A5LS 화면은 반드시 Cloud Functions Gateway를 통해 조회·변경합니다.
    match /payments/{document=**} { allow read, write: if false; }
    match /payment_events/{document=**} { allow read, write: if false; }
    match /webhook_events/{document=**} { allow read, write: if false; }
    match /refunds/{document=**} { allow read, write: if false; }
    match /cancel_requests/{document=**} { allow read, write: if false; }
    match /settlements/{document=**} { allow read, write: if false; }
    match /payouts/{document=**} { allow read, write: if false; }
    match /pg_gateway_settings/{document=**} { allow read, write: if false; }
    match /pg_provider_settings/{document=**} { allow read, write: if false; }
    match /company_pg_credentials/{document=**} { allow read, write: if false; }
    match /payment_provider_configs/{document=**} { allow read, write: if false; }
    match /payment_feature_flags/{document=**} { allow read, write: if false; }
    match /payment_intents/{document=**} { allow read, write: if false; }
    match /payment_attempts/{document=**} { allow read, write: if false; }
    match /payment_transactions/{document=**} { allow read, write: if false; }
    match /payment_sessions/{document=**} { allow read, write: if false; }
    match /payment_distribution_plans/{document=**} { allow read, write: if false; }
    match /payment_distribution_lines/{document=**} { allow read, write: if false; }
    match /payup_merchant_profiles/{document=**} { allow read, write: if false; }
    match /payup_submerchants/{document=**} { allow read, write: if false; }
    match /payup_distribution_policies/{document=**} { allow read, write: if false; }
    match /payup_transaction_snapshots/{document=**} { allow read, write: if false; }
    match /payup_settlement_snapshots/{document=**} { allow read, write: if false; }
    match /payup_integration_logs/{document=**} { allow read, write: if false; }
    match /payup_partner_activity/{document=**} { allow read, write: if false; }
    match /transaction_reconciliation_runs/{document=**} { allow read, write: if false; }
    match /transaction_reconciliation_issues/{document=**} { allow read, write: if false; }
    match /settlement_reconciliation_runs/{document=**} { allow read, write: if false; }
    match /settlement_reconciliation_issues/{document=**} { allow read, write: if false; }
    match /settlement_batches/{document=**} { allow read, write: if false; }
    match /settlement_lines/{document=**} { allow read, write: if false; }
    match /manual_action_queue/{document=**} { allow read, write: if false; }
    match /dead_letter_queue/{document=**} { allow read, write: if false; }
    match /integration_outbox/{document=**} { allow read, write: if false; }
    match /audit_logs/{document=**} { allow read, write: if false; }
    match /payment_audit_logs/{document=**} { allow read, write: if false; }
    match /business_events/{document=**} { allow read, write: if false; }
    match /notification_logs/{document=**} { allow read, write: if false; }
    match /gmail_delivery_queue/{document=**} { allow read, write: if false; }
    match /order_private/{document=**} { allow read, write: if false; }
    match /access_members/{document=**} { allow read, write: if false; }
    match /payup_change_requests/{document=**} { allow read, write: if false; }
    match /tablet_enrollment_codes/{document=**} { allow read, write: if false; }
    match /public_request_throttles/{document=**} { allow read, write: if false; }
    match /a4_handoff_tokens/{document=**} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
