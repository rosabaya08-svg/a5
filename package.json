{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev -p 5002 --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "start:local": "next start -p 5002",
    "lint": "eslint",
    "check:env": "node scripts/check-env.mjs",
    "check:commerce-linkage": "node scripts/check-commerce-linkage.mjs",
    "check:no-secrets": "node scripts/check-no-secrets.mjs",
    "check:firestore-products": "node scripts/check-firestore-products.mjs",
    "check:functions-drift": "node scripts/check-functions-drift.mjs",
    "check:member-hub": "node scripts/check-member-hub-sync.mjs",
    "smoke:member-hub": "node scripts/run-member-hub-live-smoke.mjs",
    "check:live-action-readiness": "node scripts/check-live-action-readiness.mjs",
    "check:a4-local-room-upsert": "node scripts/check-a4-local-room-upsert.mjs",
    "check:live-pg-provider": "node scripts/check-live-pg-provider.mjs",
    "e2e:live-write": "node scripts/run-live-write-e2e.mjs",
    "migrate:payup-provider": "node scripts/migrate-payup-provider.mjs",
    "check:payment-provider-policy": "node scripts/check-payment-provider-policy.mjs",
    "check:release:ready": "node scripts/check-release-ready.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:release": "node scripts/check-env.mjs && node scripts/check-no-secrets.mjs && node scripts/check-routes.mjs && node scripts/check-release-ready.mjs && node scripts/check-payment-provider-policy.mjs && node scripts/check-commerce-linkage.mjs && npm run lint && npm run build && npm --prefix functions run build",
    "seed:firestore:products": "node scripts/seed-test-1004-firestore.mjs",
    "seed:firestore:test-1004": "node scripts/seed-test-1004-firestore.mjs",
    "seed:firestore:multi-vendor-smoke": "node scripts/seed-multi-vendor-storefront-smoke.mjs",
    "verify:firestore:multi-vendor-smoke": "node scripts/seed-multi-vendor-storefront-smoke.mjs",
    "verify:product-business-urls": "node scripts/backfill-product-business-urls.mjs",
    "seed:firestore:foundation": "node scripts/seed-firestore-foundation.mjs",
    "seed:firestore:foundation:dry-run": "node scripts/seed-firestore-foundation.mjs --dry-run",
    "seed:firestore:commerce": "node scripts/seed-firestore-commerce.mjs",
    "build:functions": "npm --prefix functions run build",
    "build:cloudflare": "next build --webpack && opennextjs-cloudflare build --skipNextBuild",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "upload:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "exceljs": "4.4.0",
    "firebase": "^12.13.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.98.0"
  }
}
