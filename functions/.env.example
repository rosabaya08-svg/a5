PG_PROVIDER=
PG_ENVIRONMENT=test
PG_CLIENT_KEY=
PG_SECRET_KEY=
PG_MERCHANT_ID=
PG_CHANNEL_KEY=
PG_WEBHOOK_SECRET=
PG_API_BASE_URL=
PG_READY_ENDPOINT=
PG_CONFIRM_ENDPOINT=
PG_CANCEL_ENDPOINT=
PG_WEBHOOK_VERIFY_ALGORITHM=
PG_SUCCESS_URL=
PG_FAIL_URL=
PG_WEBHOOK_URL=
PAYMENT_WEBHOOK_URL=

# PayUp 장바구니 PG non-secret runtime configuration.
# Secrets PAYUP_API_KEY, PAYUP_API_CERT_KEY, A5_ORDER_PII_ENCRYPTION_KEY,
# A5LS_GATEWAY_HMAC_SECRET are stored only in Firebase Secret Manager.
PAYUP_MERCHANT_ID=
PAYUP_ENVIRONMENT=test
PAYUP_VPC_CONNECTOR=
PAYUP_FIXED_EGRESS_IP=
PAYUP_FIXED_IP_REGISTERED=false
PAYUP_LIVE_CALLS_ENABLED=false
# Mobile auth_return must be the public payupMobileAuthReturn Cloud Function URL.
PAYUP_AUTH_RETURN_URL=https://asia-northeast3-your-project.cloudfunctions.net/payupMobileAuthReturn
PAYUP_SUCCESS_RETURN_URL=https://your-domain.example/orders/guest/live
PAYUP_FAILURE_RETURN_URL=https://your-domain.example/q/live
PAYUP_SESSION_CLEANUP_ENABLED=false
PAYUP_RECON_SCHEDULE_ENABLED=false
PAYUP_REQUIRE_APP_CHECK=false
PAYUP_REQUIRE_TABLET_AUTH=false
PAYUP_ENFORCE_ORIGIN_ALLOWLIST=false
A5_ALLOWED_PUBLIC_ORIGINS=https://your-domain.example
A5_CHANNEL_RETURN_ORIGINS=https://lussoboutique.co.kr
A5_BOOTSTRAP_SUPER_ADMIN_EMAILS=
A5_LEGACY_MOCK_PAYMENT_ENABLED=false

# Production activation baseline:
# PAYUP_VPC_CONNECTOR=a5-payup-connector
# PAYUP_FIXED_EGRESS_IP=203.0.113.10
# PAYUP_LIVE_CALLS_ENABLED=true
# PAYUP_FIXED_IP_REGISTERED=true
# PAYUP_REQUIRE_APP_CHECK=true
# PAYUP_REQUIRE_TABLET_AUTH=true
# PAYUP_ENFORCE_ORIGIN_ALLOWLIST=true
# PAYUP_SESSION_CLEANUP_ENABLED=true
# PAYUP_RECON_SCHEDULE_ENABLED=true
# A5_LEGACY_MOCK_PAYMENT_ENABLED=false

# Infra verification request: payup-fixed-ip-20260730-008

# A4/MOMCARE room import. Source project is read-only; writes go only to the A5 default project.
A4_SOURCE_PROJECT_ID=signage-partner
A4_NURSERIES_COLLECTION_PATHS=nurseries,signage_partners,partners,companies
A4_NURSERIES_COLLECTION_GROUP=
A4_NURSERY_BUSINESS_FIELD=business_registration_no
A4_NURSERY_ID_FIELD=nursery_id
A4_ROOMS_COLLECTION_PATH=rooms
A4_ROOMS_COLLECTION_GROUP=
A4_ROOMS_NURSERY_FIELD=nursery_id
A4_ROOMS_BUSINESS_FIELD=business_registration_no
A5_ALLOW_BETA_ROOM_SYNC=false
