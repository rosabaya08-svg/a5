rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : "";
    }

    function uid() {
      return signedIn() ? request.auth.uid : "";
    }

    function isMasterEmail() {
      return signedIn() && request.auth.token.email == "rosabaya08@gmail.com";
    }

    function isSuperAdmin() {
      return signedIn() && role() == "SUPER_ADMIN" && isMasterEmail();
    }

    function isSeedAdmin() {
      return signedIn() &&
        (request.auth.token.seed_admin == true || role() == "seed_admin");
    }

    function isSuperOrSeedAdmin() {
      return isSuperAdmin() || isSeedAdmin();
    }

    function userActive() {
      return signedIn() &&
        (
          !exists(/databases/$(database)/documents/users/$(uid())) ||
          get(/databases/$(database)/documents/users/$(uid())).data.account_status in ["active", "approved"]
        );
    }

    function companyApproved(companyId) {
      return exists(/databases/$(database)/documents/companies/$(companyId)) &&
        get(/databases/$(database)/documents/companies/$(companyId)).data.status in ["approved", "active"];
    }

    function isCompanyAdmin(companyId) {
      return userActive() &&
        role() == "COMPANY_ADMIN" &&
        request.auth.token.company_id == companyId &&
        companyApproved(companyId);
    }

    function isNurseryAdmin(nurseryId) {
      return userActive() &&
        role() == "NURSERY_ADMIN" &&
        request.auth.token.nursery_id == nurseryId;
    }

    function isTabletDevice(nurseryId, roomId, tabletId) {
      return signedIn() &&
        role() == "TABLET_DEVICE" &&
        request.auth.token.nursery_id == nurseryId &&
        request.auth.token.room_id == roomId &&
        request.auth.token.tablet_id == tabletId;
    }

    function hasStatus(data, allowed) {
      return ("status" in data) && data.status in allowed;
    }

    function companyScoped(data) {
      return ("company_id" in data) && isCompanyAdmin(data.company_id);
    }

    function nurseryScoped(data) {
      return ("nursery_id" in data) && isNurseryAdmin(data.nursery_id);
    }

    function tabletScoped(data) {
      return ("nursery_id" in data) &&
        ("room_id" in data) &&
        ("tablet_id" in data) &&
        isTabletDevice(data.nursery_id, data.room_id, data.tablet_id);
    }

    function activeProduct(data) {
      return hasStatus(data, ["approved", "active"]) &&
        ("company_id" in data) &&
        companyApproved(data.company_id) &&
        (!("is_visible" in data) || data.is_visible == true);
    }

    function activeOption(data) {
      return hasStatus(data, ["active", "approved"]) &&
        (!("company_id" in data) || companyApproved(data.company_id));
    }

    function activeContent(data) {
      return hasStatus(data, ["approved", "active", "published", "live"]) &&
        (!("visible_from" in data) || data.visible_from <= request.time) &&
        (!("visible_until" in data) || data.visible_until >= request.time);
    }

    function companyCreatesPending(data) {
      return ("company_id" in data) &&
        isCompanyAdmin(data.company_id) &&
        data.status in ["draft", "pending_approval"] &&
        ("updated_at" in data);
    }

    function companyKeepsOwnership(beforeData, afterData) {
      return ("company_id" in beforeData) &&
        ("company_id" in afterData) &&
        beforeData.company_id == afterData.company_id &&
        isCompanyAdmin(afterData.company_id);
    }

    function companyUpdatesPending(beforeData, afterData) {
      return companyKeepsOwnership(beforeData, afterData) &&
        beforeData.status in ["draft", "pending_approval", "rejected", "needs_revision"] &&
        afterData.status in ["draft", "pending_approval"] &&
        ("updated_at" in afterData);
    }

    function superStatusWrite(data) {
      return isSuperOrSeedAdmin() &&
        ("status" in data) &&
        ("updated_at" in data);
    }

    function guestQrRead(data) {
      return ("guest_read_enabled" in data) &&
        data.guest_read_enabled == true &&
        data.status == "active" &&
        ("short_code" in data);
    }

    function guestOrderRead(data) {
      return ("guest_lookup_enabled" in data) &&
        data.guest_lookup_enabled == true &&
        ("order_no" in data);
    }

    match /users/{userId} {
      allow get: if isSuperOrSeedAdmin() || (signedIn() && uid() == userId);
      allow list: if isSuperOrSeedAdmin();
      allow create, update, delete: if isSuperOrSeedAdmin();
    }

    match /company_signup_requests/{requestId} {
      allow get, list: if isSuperOrSeedAdmin();
      allow create, update, delete: if false;
    }

    match /companies/{companyId} {
      allow get: if isSuperOrSeedAdmin() || isCompanyAdmin(companyId);
      allow list: if isSuperOrSeedAdmin();
      allow create, update: if superStatusWrite(request.resource.data);
      allow delete: if false;
    }

    match /company_onboarding/{onboardingId} {
      allow get, list: if isSuperOrSeedAdmin() || companyScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /company_documents/{documentId} {
      allow get, list: if isSuperOrSeedAdmin() || companyScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /company_contacts/{contactId} {
      allow get, list: if activeContent(resource.data) || isSuperOrSeedAdmin() || companyScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /products/{productId} {
      allow get, list: if activeProduct(resource.data) || companyScoped(resource.data) || isSuperOrSeedAdmin();
      allow create: if companyCreatesPending(request.resource.data) || superStatusWrite(request.resource.data);
      allow update: if companyUpdatesPending(resource.data, request.resource.data) || superStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /product_options/{optionId} {
      allow get, list: if activeOption(resource.data) || companyScoped(resource.data) || isSuperOrSeedAdmin();
      allow create: if companyCreatesPending(request.resource.data) || superStatusWrite(request.resource.data);
      allow update: if companyUpdatesPending(resource.data, request.resource.data) || superStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /product_detail_pages/{pageId} {
      allow get, list: if activeContent(resource.data) || companyScoped(resource.data) || isSuperOrSeedAdmin();
      allow create: if companyCreatesPending(request.resource.data) || superStatusWrite(request.resource.data);
      allow update: if companyUpdatesPending(resource.data, request.resource.data) || superStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /product_reviews/{reviewId} {
      allow get, list: if activeContent(resource.data) || companyScoped(resource.data) || isSuperOrSeedAdmin();
      allow create, update, delete: if false;
    }

    match /product_questions/{questionId} {
      allow get, list: if companyScoped(resource.data) || isSuperOrSeedAdmin();
      allow create, update, delete: if false;
    }

    match /brands/{brandId} {
      allow get, list: if activeContent(resource.data) || companyScoped(resource.data) || isSuperOrSeedAdmin();
      allow create, update: if isSuperAdmin() && ("status" in request.resource.data) && ("updated_at" in request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /home_sections/{sectionId} {
      allow get, list: if activeContent(resource.data) || isSuperOrSeedAdmin();
      allow create, update: if isSuperAdmin() && ("status" in request.resource.data) && ("updated_at" in request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /marketing_banners/{bannerId} {
      allow get, list: if activeContent(resource.data) || companyScoped(resource.data) || isSuperOrSeedAdmin();
      allow create, update: if isSuperAdmin() && ("status" in request.resource.data) && ("updated_at" in request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /marketing_videos/{videoId} {
      allow get, list: if activeContent(resource.data) || companyScoped(resource.data) || isSuperOrSeedAdmin();
      allow create, update: if isSuperAdmin() && ("status" in request.resource.data) && ("updated_at" in request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /exhibitions/{exhibitionId} {
      allow get, list: if activeContent(resource.data) || companyScoped(resource.data) || isSuperOrSeedAdmin();
      allow create, update: if superStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /exhibition_products/{entryId} {
      allow get, list: if activeContent(resource.data) || companyScoped(resource.data) || isSuperOrSeedAdmin();
      allow create, update: if superStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /popups/{popupId} {
      allow get, list: if activeContent(resource.data) || isSuperOrSeedAdmin();
      allow create, update: if superStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /tablet_home_configs/{configId} {
      allow get, list: if activeContent(resource.data) || nurseryScoped(resource.data) || tabletScoped(resource.data) || isSuperOrSeedAdmin();
      allow create, update: if isSuperAdmin() && ("status" in request.resource.data) && ("updated_at" in request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /media_assets/{assetId} {
      allow get, list: if activeContent(resource.data) || companyScoped(resource.data) || nurseryScoped(resource.data) || isSuperOrSeedAdmin();
      allow create: if companyCreatesPending(request.resource.data) || superStatusWrite(request.resource.data);
      allow update: if companyUpdatesPending(resource.data, request.resource.data) || superStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /nurseries/{nurseryId} {
      allow get: if isSuperOrSeedAdmin() || isNurseryAdmin(nurseryId);
      allow list: if isSuperOrSeedAdmin();
      allow create, update: if superStatusWrite(request.resource.data);
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow get, list: if isSuperOrSeedAdmin() || nurseryScoped(resource.data) || tabletScoped(resource.data);
      allow create, update: if superStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /tablets/{tabletId} {
      allow get, list: if isSuperOrSeedAdmin() || nurseryScoped(resource.data) || tabletScoped(resource.data);
      allow create, update: if superStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /carts/{cartId} {
      allow get, list: if isSuperOrSeedAdmin() || nurseryScoped(resource.data) || tabletScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /cart_items/{cartItemId} {
      allow get, list: if isSuperOrSeedAdmin() || nurseryScoped(resource.data) || tabletScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /qr_payment_sessions/{sessionId} {
      allow get: if isSuperOrSeedAdmin() || nurseryScoped(resource.data) || tabletScoped(resource.data) || guestQrRead(resource.data);
      allow list: if isSuperOrSeedAdmin() || nurseryScoped(resource.data) || tabletScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /orders/{orderId} {
      allow get: if isSuperOrSeedAdmin() || nurseryScoped(resource.data) || guestOrderRead(resource.data);
      allow list: if isSuperOrSeedAdmin() || nurseryScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /order_items/{orderItemId} {
      allow get: if isSuperOrSeedAdmin() || companyScoped(resource.data) || nurseryScoped(resource.data) || guestOrderRead(resource.data);
      allow list: if isSuperOrSeedAdmin() || companyScoped(resource.data) || nurseryScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow get, list: if isSuperOrSeedAdmin();
      allow create, update, delete: if false;
    }

    match /payment_events/{eventId} {
      allow get, list: if isSuperOrSeedAdmin();
      allow create, update, delete: if false;
    }

    match /webhook_events/{eventId} {
      allow get, list: if isSuperOrSeedAdmin();
      allow create, update, delete: if false;
    }

    match /pg_gateway_settings/{settingId} {
      allow get, list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /pg_provider_settings/{settingId} {
      allow get, list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /company_pg_credentials/{credentialId} {
      allow get, list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /inventory_movements/{movementId} {
      allow get, list: if isSuperOrSeedAdmin() || companyScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow get, list: if isSuperOrSeedAdmin();
      allow create, update, delete: if false;
    }

    match /payment_audit_logs/{logId} {
      allow get, list: if isSuperOrSeedAdmin();
      allow create, update, delete: if false;
    }

    match /refunds/{refundId} {
      allow get, list: if isSuperOrSeedAdmin() || companyScoped(resource.data) || nurseryScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /cancel_requests/{requestId} {
      allow get, list: if isSuperOrSeedAdmin() || companyScoped(resource.data) || nurseryScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /delivery_events/{eventId} {
      allow get, list: if isSuperOrSeedAdmin() || companyScoped(resource.data) || nurseryScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /pickup_events/{eventId} {
      allow get, list: if isSuperOrSeedAdmin() || companyScoped(resource.data) || nurseryScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /settlements/{settlementId} {
      allow get, list: if isSuperOrSeedAdmin() || companyScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /payouts/{payoutId} {
      allow get, list: if isSuperOrSeedAdmin() || companyScoped(resource.data);
      allow create, update, delete: if false;
    }

    match /notification_logs/{logId} {
      allow get, list: if isSuperOrSeedAdmin();
      allow create, update, delete: if false;
    }

    match /gmail_delivery_queue/{mailId} {
      allow get, list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /a4_handoff_tokens/{tokenId} {
      allow read, write: if false;
    }

    match /system_status/{statusId} {
      allow get, list: if signedIn();
      allow create, update: if superStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /policies/{policyId} {
      allow get, list: if activeContent(resource.data) || signedIn();
      allow create, update: if superStatusWrite(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
